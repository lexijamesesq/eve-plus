{
  "name": "@eve-plus/commissioning",
  "version": "0.6.1",
  "description": "Commissioning for Vercel eve: an agent hands software work to a worker, answers its questions and decides its proposals. Ships a Cyrus connector.",
  "license": "MIT",
  "keywords": [
    "eve",
    "commissioning",
    "mcp",
    "cyrus",
    "agent-extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lexijamesesq/eve-plus.git",
    "directory": "packages/commissioning"
  },
  "homepage": "https://github.com/lexijamesesq/eve-plus/tree/main/packages/commissioning#readme",
  "bugs": {
    "url": "https://github.com/lexijamesesq/eve-plus/issues"
  },
  "type": "module",
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension",
      "externalDependencies": [
        "better-sqlite3"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.mjs"
    },
    "./cyrus": {
      "types": "./dist/src/cyrus.d.ts",
      "import": "./dist/src/cyrus.js"
    }
  },
  "scripts": {
    "build": "eve extension build && tsc -p tsconfig.build.json",
    "prepare": "eve extension build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "13.0.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "eve": "0.91.0",
    "typescript": "^5.0.0",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "eve": "^0.91.0"
  },
  "engines": {
    "node": ">=24"
  }
}
